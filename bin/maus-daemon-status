#!/bin/bash
# maus:group=daemon
# maus:summary=Is mausd up? Health, service state, recent log lines
# maus:args=[--restart]
# maus:risk=safe
# maus:rung=1
# maus:examples=maus daemon status|maus daemon status --restart
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"

if [[ "${1:-}" == "--restart" ]] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user restart mausd.service
  maus_log "restart"
fi

if curl -fsS --max-time 2 "$MAUSD_URL/api/health" 2>/dev/null; then
  echo
  echo "mausd: up at $MAUSD_URL"
else
  echo "mausd: not answering at $MAUSD_URL"
fi
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user --no-pager status mausd.service 2>/dev/null | head -5 || true
  echo "--- last log lines ---"
  journalctl --user -u mausd.service -n 15 --no-pager 2>/dev/null || true
fi
