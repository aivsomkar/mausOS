#!/bin/bash
# maus:group=core
# maus:summary=Check what works on this machine (deps, a11y bus, Hyprland, mausd, engines)
# maus:args=[--json]
# maus:risk=safe
# maus:rung=1
# maus:json=true
# maus:examples=maus doctor
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"

WANT_JSON=0; maus_want_json "$@" && WANT_JSON=1
FAILED=0
ROWS=()

row() {
  # row <status ok|warn|fail> <name> <detail>
  local status=$1 name=$2 detail=$3
  [[ $status == fail ]] && FAILED=1
  ROWS+=("$status"$'\t'"$name"$'\t'"$detail")
  if [[ $WANT_JSON -eq 0 ]]; then
    local mark="✓"
    [[ $status == warn ]] && mark="!"
    [[ $status == fail ]] && mark="✗"
    printf '%s %-22s %s\n' "$mark" "$name" "$detail"
  fi
}

check_cmd() {
  # check_cmd <name> <required 1|0> <why>
  if command -v "$1" >/dev/null 2>&1; then
    row ok "$1" "$(command -v "$1")"
  elif [[ $2 == 1 ]]; then
    row fail "$1" "missing: $3"
  else
    row warn "$1" "missing: $3"
  fi
}

check_cmd hyprctl 1 "Hyprland; needed by maus win *, shell hotkey"
check_cmd jq 1 "JSON in the commands and installer"
check_cmd tmux 1 "shared terminal (maus term *)"
check_cmd python3 1 "AT-SPI tool"
check_cmd grim 0 "screenshots (maus see shot)"
check_cmd wl-copy 0 "clipboard (maus sys clipboard)"
check_cmd notify-send 0 "notifications (maus sys notify)"
check_cmd wtype 0 "virtual keyboard input (maus win input)"
check_cmd socat 0 "Hyprland event stream (maus win events)"
check_cmd nmcli 0 "network (maus net *)"
check_cmd wpctl 0 "audio (maus hw volume)"
check_cmd brightnessctl 0 "brightness (maus hw brightness)"
check_cmd chromium 0 "shell window (maus shell open)"
check_cmd node 1 "mausd and maus mcp"
check_cmd curl 1 "talking to mausd"
check_cmd opencode 0 "default local engine"
check_cmd ollama 0 "local models"

if command -v python3 >/dev/null 2>&1; then
  if python3 -c 'import gi; gi.require_version("Atspi","2.0"); from gi.repository import Atspi' 2>/dev/null; then
    row ok "python Atspi" "python-gobject + at-spi2-core importable"
  else
    row fail "python Atspi" "pacman -S python-gobject at-spi2-core"
  fi
fi

if command -v busctl >/dev/null 2>&1; then
  enabled=$(busctl --user get-property org.a11y.Bus /org/a11y/bus org.a11y.Status IsEnabled 2>/dev/null | awk '{print $2}' || true)
  case "$enabled" in
    true) row ok "a11y bus" "org.a11y.Status IsEnabled=true" ;;
    false) row warn "a11y bus" "IsEnabled=false; run: bash install.sh --only environment, then re-login" ;;
    *) row warn "a11y bus" "no answer from org.a11y.Bus (is a session bus running?)" ;;
  esac
fi

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  row ok "hyprland session" "$(hyprctl version -j 2>/dev/null | jq -r '.tag // .commit // "running"' 2>/dev/null || echo running)"
else
  row warn "hyprland session" "not inside Hyprland (window commands unavailable here)"
fi

if [[ -f "$HOME/.config/hypr/mausos.conf" ]]; then
  row ok "hypr layer" "$HOME/.config/hypr/mausos.conf"
else
  row warn "hypr layer" "missing; run: bash install.sh --only hyprland"
fi

if curl -fsS --max-time 2 "$MAUSD_URL/api/health" >/dev/null 2>&1; then
  row ok "mausd" "$MAUSD_URL"
else
  row warn "mausd" "not answering on $MAUSD_URL (systemctl --user status mausd)"
fi

if [[ -f "${OMB_DATA_DIR:-$HOME/.openmausbot}/config.json" ]] && jq -e '.mcpServers.maus.enabled == true' "${OMB_DATA_DIR:-$HOME/.openmausbot}/config.json" >/dev/null 2>&1; then
  row ok "maus mcp" "registered with mausd"
else
  row warn "maus mcp" "not registered; run: bash install.sh --only mcp"
fi

if command -v ollama >/dev/null 2>&1; then
  models=$(ollama list 2>/dev/null | awk 'NR>1{print $1}' | paste -sd, - || true)
  if [[ -n $models ]]; then row ok "ollama models" "$models"; else row warn "ollama models" "none pulled (ollama pull qwen3:8b)"; fi
fi

fstype=$(findmnt -no FSTYPE --target "$HOME" 2>/dev/null || echo unknown)
if [[ $fstype == btrfs ]]; then
  row ok "home filesystem" "btrfs (checkpoints possible)"
else
  row warn "home filesystem" "$fstype (maus file snapshot needs btrfs)"
fi

n=$(find "$MAUS_REGISTRY_DIR" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
row ok "registry" "$n manifests in $MAUS_REGISTRY_DIR"

if [[ $WANT_JSON -eq 1 ]]; then
  printf '['
  first=1
  for r in "${ROWS[@]}"; do
    IFS=$'\t' read -r s n d <<< "$r"
    [[ $first -eq 1 ]] || printf ','
    first=0
    printf '{"status":"%s","name":"%s","detail":"%s"}' "$s" "$(maus_json_escape "$n")" "$(maus_json_escape "$d")"
  done
  printf ']\n'
fi

exit $FAILED
