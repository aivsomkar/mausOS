#!/bin/bash
# maus:group=app
# maus:summary=Give keyboard focus to a widget by name or id
# maus:args=<app|pid> <name|id>
# maus:risk=safe
# maus:rung=3
# maus:json=true
# maus:examples=maus app focus firefox "Search or enter address"
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 2 ]] || { maus_usage; exit 1; }
maus_atspi focus "$@"
