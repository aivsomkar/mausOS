#!/bin/bash
# maus:group=sys
# maus:summary=Show a desktop notification
# maus:args=<title> [body] [--urgency low|normal|critical]
# maus:risk=safe
# maus:rung=1
# maus:examples=maus sys notify "Build finished" "12 tests passed"
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 1 ]] || { maus_usage; exit 1; }
maus_need notify-send

urgency=normal
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --urgency) urgency=$2; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
notify-send -a MausOS -u "$urgency" "${args[0]}" "${args[1]:-}"
