#!/bin/bash
# maus:group=app
# maus:summary=Activate a widget by name or id through its accessibility action (click, press, toggle…)
# maus:args=<app|pid> <name|id> [--action NAME]
# maus:risk=ask
# maus:rung=3
# maus:json=true
# maus:examples=maus app press firefox Reload|maus app press gimp 0.4.2 --action click
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 2 ]] || { maus_usage; exit 1; }
maus_log "press $1 '$2'"
maus_atspi press "$@"
