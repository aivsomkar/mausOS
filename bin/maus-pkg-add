#!/bin/bash
# maus:group=pkg
# maus:summary=Install packages (omarchy → yay → pacman; flatpak ids go to Flathub)
# maus:args=<package…>
# maus:risk=privileged
# maus:rung=1
# maus:requires-sudo=true
# maus:examples=maus pkg add blender|maus pkg add org.gimp.GIMP
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 1 ]] || { maus_usage; exit 1; }

flat=()
native=()
for p in "$@"; do
  if [[ $p == *.*.* ]] && command -v flatpak >/dev/null 2>&1; then flat+=("$p"); else native+=("$p"); fi
done

maus_log "pkg add $*"
if [[ ${#native[@]} -gt 0 ]]; then
  if command -v omarchy-pkg-add >/dev/null 2>&1; then
    omarchy-pkg-add "${native[@]}"
  elif command -v omarchy >/dev/null 2>&1; then
    omarchy pkg add "${native[@]}"
  elif command -v yay >/dev/null 2>&1; then
    yay -S --needed --noconfirm "${native[@]}"
  else
    sudo pacman -S --needed --noconfirm "${native[@]}"
  fi
fi
if [[ ${#flat[@]} -gt 0 ]]; then
  flatpak install -y flathub "${flat[@]}"
fi
echo "installed: $*"
