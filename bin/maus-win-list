#!/bin/bash
# maus:group=win
# maus:summary=List open windows (address, class, title, workspace, focus, lease) as JSON
# maus:args=[--all]
# maus:risk=safe
# maus:rung=4
# maus:json=true
# maus:examples=maus win list|maus win list --all
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
maus_need jq

leases="$MAUS_RUNTIME_DIR/leases"
mkdir -p "$MAUS_RUNTIME_DIR"
touch "$leases"

filter='.'
[[ "${1:-}" == "--all" ]] || filter='map(select(.mapped == true and .hidden == false))'

maus_hypr clients -j | jq --rawfile leases "$leases" "
  $filter
  | map({
      address, class, title, pid,
      workspace: .workspace.name,
      focused: (.focusHistoryID == 0),
      floating, fullscreen,
      at, size,
      leased: (\$leases | split(\"\n\") | map(select(length > 0) | split(\"\t\")[0]) | index(.address) != null)
    })
  | sort_by(.workspace, .address)
"
