#!/bin/bash
# maus:group=registry
# maus:summary=Show how one app can be driven: interfaces per rung, capabilities, quirks
# maus:args=<id>
# maus:risk=safe
# maus:rung=1
# maus:json=true
# maus:examples=maus registry show firefox
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 1 ]] || { maus_usage; exit 1; }
maus_need jq

f="$MAUS_REGISTRY_DIR/$1.json"
[[ -f $f ]] || maus_die "no manifest '$1' (maus registry list)"
jq . "$f"
