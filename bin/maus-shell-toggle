#!/bin/bash
# maus:group=shell
# maus:summary=Show or hide the MausOS shell (Super+A); opens it first if needed
# maus:args=
# maus:risk=safe
# maus:rung=4
# maus:examples=maus shell toggle
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
maus_need jq

existing=$(maus_hypr clients -j | jq -r '.[] | select(.class == "mausos-shell") | .address' | head -1)
if [[ -z $existing ]]; then
  exec "$MAUS_BIN_DIR/maus-shell-open"
fi
maus_hypr dispatch togglespecialworkspace maus >/dev/null
