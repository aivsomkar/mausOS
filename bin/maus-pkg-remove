#!/bin/bash
# maus:group=pkg
# maus:summary=Remove packages (omarchy → yay → pacman; flatpak ids via flatpak)
# maus:args=<package…>
# maus:risk=privileged
# maus:rung=1
# maus:requires-sudo=true
# maus:examples=maus pkg remove blender
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 1 ]] || { maus_usage; exit 1; }

flat=()
native=()
for p in "$@"; do
  if [[ $p == *.*.* ]] && command -v flatpak >/dev/null 2>&1; then flat+=("$p"); else native+=("$p"); fi
done

maus_log "pkg remove $*"
if [[ ${#native[@]} -gt 0 ]]; then
  if command -v omarchy-pkg-remove >/dev/null 2>&1; then
    omarchy-pkg-remove "${native[@]}"
  elif command -v omarchy >/dev/null 2>&1; then
    omarchy pkg remove "${native[@]}"
  elif command -v yay >/dev/null 2>&1; then
    yay -Rns --noconfirm "${native[@]}"
  else
    sudo pacman -Rns --noconfirm "${native[@]}"
  fi
fi
if [[ ${#flat[@]} -gt 0 ]]; then
  flatpak uninstall -y "${flat[@]}"
fi
echo "removed: $*"
