#!/bin/bash
# maus:group=net
# maus:summary=Network status as JSON: devices, active connection, visible Wi‑Fi with signal
# maus:args=[--scan]
# maus:risk=safe
# maus:rung=1
# maus:json=true
# maus:examples=maus net status|maus net status --scan
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
maus_need nmcli jq

[[ "${1:-}" == "--scan" ]] && nmcli dev wifi rescan >/dev/null 2>&1 || true

devices=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status | awk -F: '{printf "{\"device\":\"%s\",\"type\":\"%s\",\"state\":\"%s\",\"connection\":\"%s\"}\n", $1,$2,$3,$4}' | jq -s .)
wifi=$(nmcli -t -f ACTIVE,SSID,SIGNAL,FREQ,SECURITY dev wifi list 2>/dev/null | awk -F: '$2 != "" {printf "{\"active\":%s,\"ssid\":\"%s\",\"signal\":%s,\"freq\":\"%s\",\"security\":\"%s\"}\n", ($1=="yes"?"true":"false"),$2,$3,$4,$5}' | jq -s 'sort_by(-.signal)')
conn=$(nmcli -t -f NAME,TYPE,DEVICE con show --active | awk -F: '{printf "{\"name\":\"%s\",\"type\":\"%s\",\"device\":\"%s\"}\n", $1,$2,$3}' | jq -s .)
state=$(nmcli -t -f STATE general | head -1)

jq -n --arg state "$state" --argjson devices "$devices" --argjson wifi "$wifi" --argjson active "$conn" \
  '{state: $state, active: $active, devices: $devices, wifi: $wifi}'
