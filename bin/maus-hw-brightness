#!/bin/bash
# maus:group=hw
# maus:summary=Get or set screen brightness
# maus:args=[get] | set <0-100> | up | down
# maus:risk=safe
# maus:rung=1
# maus:examples=maus hw brightness|maus hw brightness set 60
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
maus_need brightnessctl

case "${1:-get}" in
  get) brightnessctl -m | awk -F, '{print $4}' ;;
  set) [[ -n ${2:-} ]] || maus_die "set needs a percentage"; maus_log "brightness $2"; brightnessctl -q set "$2%"; brightnessctl -m | awk -F, '{print $4}' ;;
  up) brightnessctl -q set +10%; brightnessctl -m | awk -F, '{print $4}' ;;
  down) brightnessctl -q set 10%-; brightnessctl -m | awk -F, '{print $4}' ;;
  *) maus_die "use: get | set N | up | down" ;;
esac
