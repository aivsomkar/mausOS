#!/bin/bash
# maus:group=term
# maus:summary=Type a command into a shared terminal session and press Enter (visible to the user)
# maus:args=<name> <command…> [--no-enter]
# maus:risk=ask
# maus:rung=1
# maus:examples=maus term send build "make -j8"|maus term send build "y" --no-enter
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 2 ]] || { maus_usage; exit 1; }
maus_need tmux

name=$1; shift
enter=1
parts=()
for a in "$@"; do
  if [[ $a == "--no-enter" ]]; then enter=0; else parts+=("$a"); fi
done
session="maus-$name"
tmux has-session -t "$session" 2>/dev/null || "$MAUS_BIN_DIR/maus-term-open" "$name" --hidden >/dev/null

text="${parts[*]}"
maus_log "term send $session: $text"
tmux send-keys -t "$session" -l -- "$text"
[[ $enter -eq 1 ]] && tmux send-keys -t "$session" Enter
echo "sent to $session"
