#!/bin/bash
# maus:group=file
# maus:summary=Find files by name (fd) or by content (--grep) under a directory
# maus:args=<pattern> [dir] [--grep] [--limit N]
# maus:risk=safe
# maus:rung=1
# maus:examples=maus file search "*.blend" ~/Projects|maus file search "invoice 2026" ~/Documents --grep
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 1 ]] || { maus_usage; exit 1; }

pattern=$1; shift
dir="$HOME"
grep_mode=0
limit=100
while [[ $# -gt 0 ]]; do
  case "$1" in
    --grep) grep_mode=1; shift ;;
    --limit) limit=$2; shift 2 ;;
    *) dir=$1; shift ;;
  esac
done
dir="${dir/#\~/$HOME}"

if [[ $grep_mode -eq 1 ]]; then
  maus_need rg
  rg -il --max-count 1 -- "$pattern" "$dir" 2>/dev/null | head -n "$limit"
elif command -v fd >/dev/null 2>&1; then
  fd --hidden --exclude .git --glob "$pattern" "$dir" 2>/dev/null | head -n "$limit"
else
  find "$dir" -iname "$pattern" -not -path '*/.git/*' 2>/dev/null | head -n "$limit"
fi
