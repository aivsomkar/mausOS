#!/bin/bash
# maus:group=app
# maus:summary=Read the visible text of an app (or one widget) through the accessibility tree
# maus:args=<app|pid> [name|id]
# maus:risk=safe
# maus:rung=3
# maus:examples=maus app text firefox|maus app text libreoffice 0.0.3
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 1 ]] || { maus_usage; exit 1; }
maus_atspi text "$@"
