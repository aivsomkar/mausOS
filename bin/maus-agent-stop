#!/bin/bash
# maus:group=agent
# maus:summary=Interrupt: stop a bot's turn (or every bot with --all), release window leases, kill virtual input
# maus:args=<bot> | --all
# maus:risk=safe
# maus:rung=1
# maus:examples=maus agent stop --all|maus agent stop coder
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../lib/maus-common.sh"
maus_help_if_asked "$@"
[[ $# -ge 1 ]] || { maus_usage; exit 1; }

# 1. Kill anything typing or clicking on the user's behalf.
pkill -x wtype 2>/dev/null || true
pkill -x ydotool 2>/dev/null || true

# 2. Release every window lease (restores borders).
"$MAUS_BIN_DIR/maus-win-release" --all >/dev/null 2>&1 || true

# 3. Interrupt turns in mausd.
stopped=0
if command -v jq >/dev/null 2>&1 && bots=$(maus_api GET /api/bots 2>/dev/null); then
  ids=$(echo "$bots" | jq -r --arg b "$1" '(if type == "object" and has("bots") then .bots else . end)
    | map(select($b == "--all" or .id == $b or (((.name // .displayName // "") | ascii_downcase) | contains($b | ascii_downcase))))
    | .[].id')
  for id in $ids; do
    maus_api POST "/api/bots/$id/interrupt" >/dev/null 2>&1 && stopped=$((stopped + 1)) || true
  done
fi

maus_log "stop $1 (interrupted $stopped)"
if command -v notify-send >/dev/null 2>&1; then
  notify-send -a MausOS -u critical "Agents stopped" "Interrupted $stopped bot(s); leases released."
fi
echo "interrupted $stopped bot(s); leases released"
